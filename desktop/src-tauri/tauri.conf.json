{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HOME",
  "version": "0.1.0",
  "identifier": "com.luis.home.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HOME",
        "width": 460,
        "height": 900,
        "minWidth": 390,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
